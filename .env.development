# ==============================================================================
# Cookii Environment: DEVELOPMENT (Local)
# ==============================================================================
NODE_ENV=development
PORT=4000
APP_NAME=Cookii-API-Dev
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:4000,http://127.0.0.1:4000

# Database - Local MongoDB or Atlas Free Tier
MONGODB_URI=mongodb+srv://Cookify:YQltkpLwLjy77Kd8@cluster0.f4v9j2g.mongodb.net/cookii_dev?retryWrites=true&w=majority

# Redis & BullMQ Queue (Optional in dev - in-memory fallback enabled)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=cookii_dev_jwt_access_secret_super_secure_32chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=cookii_dev_jwt_refresh_secret_super_secure_32chars
JWT_REFRESH_EXPIRES_IN=30d

# Phone OTP Provider (mock in dev = any number with OTP 123456)
OTP_PROVIDER=mock
MOCK_OTP_CODE=123456

# Google OAuth (Sandbox / Web Client ID)
GOOGLE_CLIENT_ID=mock_dev_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_dev_google_client_secret

# Razorpay Sandbox (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_wh_secret_placeholder

# Maps Provider
MAPS_PROVIDER=maplibre
MAPLIBRE_TILE_URL=https://tiles.openfreemap.org/styles/bright

# Logging & Observability
LOG_LEVEL=debug

