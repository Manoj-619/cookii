# ==============================================================================
# Cookii Environment: PRODUCTION (Live High-Availability Production)
# ==============================================================================
NODE_ENV=production
PORT=4000
APP_NAME=Cookii-API-Prod
API_PREFIX=api/v1
CORS_ORIGIN=https://admin.cookii.in,https://app.cookii.in

# Database - Production MongoDB Atlas Dedicated Replica Set (M10+)
MONGODB_URI=mongodb+srv://cookii_prod_admin:REPLACE_WITH_STRONG_VAULT_PASSWORD@prod-cluster.mongodb.net/cookii_production?retryWrites=true&w=majority&maxPoolSize=50

# Redis & BullMQ (Production Upstash / AWS ElastiCache Cluster)
REDIS_HOST=prod-redis.cookii.internal
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_PROD_REDIS_PASSWORD
REDIS_TLS=true

# Authentication & JWT Secrets (Rotated & secured via KMS / Secrets Manager)
JWT_ACCESS_SECRET=REPLACE_WITH_MINIMUM_64_CHAR_CRYPTOGRAPHIC_PROD_SECRET_KMS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_MINIMUM_64_CHAR_CRYPTOGRAPHIC_PROD_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# Phone OTP Provider (Live SMS Gateway: msg91 / Firebase Auth)
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=REPLACE_WITH_PROD_MSG91_AUTH_KEY
MSG91_TEMPLATE_ID=REPLACE_WITH_PROD_MSG91_DLT_APPROVED_TEMPLATE_ID

# Google OAuth (Live Production Google Cloud Console credentials)
GOOGLE_CLIENT_ID=prod_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_PROD_GOOGLE_CLIENT_SECRET

# Razorpay LIVE Gateway (Live keys starting with rzp_live_)
RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_LIVE_WEBHOOK_SECRET

# Maps Provider (Google Maps Platform in Production for high precision)
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_RESTRICTED_PROD_KEY

# File Storage (AWS S3 or Cloudinary)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=cookii-prod
CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_SECRET

# Observability & Monitoring
LOG_LEVEL=warn
SENTRY_DSN=https://sentry_prod_key@o000000.ingest.sentry.io/0000000

