# ==============================================================================
# ZapEat - Production-Grade Environment Configuration Template
# Bengaluru, Karnataka, India
# ==============================================================================

# Application & Server
NODE_ENV=development
PORT=4000
APP_NAME=ZapEat-API
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:4000,http://localhost:8081

# Database (MongoDB Atlas / Local)
# Local: mongodb://localhost:27017/ZapEat?authSource=admin
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ZapEat?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ZapEat

# Redis & BullMQ (Upstash Free / Local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Authentication & JWT
JWT_ACCESS_SECRET=ZapEat_super_secure_access_secret_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=ZapEat_super_secure_refresh_secret_change_in_production_32chars
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_JWT_SECRET=ZapEat_admin_super_secure_jwt_secret_32chars_long

# Phone OTP Provider (mock | msg91 | twilio)
OTP_PROVIDER=mock
MOCK_OTP_CODE=123456
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=ZapEat

# Twilio (Optional SMS Provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Service (SMTP & AWS SES)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ZapEat" <no-reply@ZapEat.in>

# AWS SES (Simple Email Service)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_EMAIL=no-reply@ZapEat.in

# Push Notifications (Firebase Cloud Messaging)
FCM_PROJECT_ID=
FCM_SERVER_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT=

# Payments (Razorpay Test Mode / Production)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_wh_secret_placeholder

# Maps Provider (maplibre | google)
MAPS_PROVIDER=maplibre
MAPLIBRE_TILE_URL=https://tiles.openfreemap.org/styles/bright
GOOGLE_MAPS_API_KEY=

# File Storage (local | cloudinary | s3)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Observability & Monitoring
SENTRY_DSN=
LOG_LEVEL=debug

# Admin Dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
ADMIN_INITIAL_EMAIL=ops@ZapEat.in
ADMIN_INITIAL_PHONE=+919876543210
ADMIN_INITIAL_PASSWORD=ZapEatAdmin@2026!
