# ==============================================================================
# Cookii - Environment Configuration Template
# Production-ready, on-demand home cook booking platform for Bengaluru, India
# ==============================================================================

# Application & Server
NODE_ENV=development
PORT=4000
APP_NAME=Cookii-API
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:4000,http://localhost:8081

# Database (MongoDB Atlas / Local)
# Local: mongodb://localhost:27017/cookii?authSource=admin
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cookii?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/cookii

# Redis & BullMQ (Upstash Free / Local)
# Local: redis://localhost:6379
# Upstash: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Authentication & JWT
JWT_ACCESS_SECRET=cookii_super_secure_access_secret_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cookii_super_secure_refresh_secret_change_in_production_32chars
JWT_REFRESH_EXPIRES_IN=30d

# Phone OTP Provider (mock | firebase | msg91)
# In development, 'mock' allows any phone number with static or generated OTP
OTP_PROVIDER=mock
MOCK_OTP_CODE=123456
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Payments (Razorpay Test Mode / Production)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_wh_secret_placeholder

# Maps Provider (maplibre | google)
MAPS_PROVIDER=maplibre
MAPLIBRE_TILE_URL=https://tiles.openfreemap.org/styles/bright
GOOGLE_MAPS_API_KEY=

# File Storage (local | cloudinary)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push Notifications (Firebase Cloud Messaging)
FCM_PROJECT_ID=
FCM_SERVER_KEY=

# Observability & Monitoring
SENTRY_DSN=
LOG_LEVEL=debug

# Admin Dashboard Defaults
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
ADMIN_INITIAL_EMAIL=ops@cookii.in
ADMIN_INITIAL_PHONE=+919876543210

