{
  "name": "cookii-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade, on-demand home cook booking platform for Bengaluru, India",
  "scripts": {
    "dev:backend": "pnpm --filter @cookii/backend run start:dev",
    "dev:admin": "pnpm --filter @cookii/admin run dev",
    "dev:mobile": "npm --prefix legacy/expo-mvp start",
    "dev:mobile:web": "npm --prefix legacy/expo-mvp run web",
    "build:backend": "pnpm --filter @cookii/backend run build",
    "build:admin": "pnpm --filter @cookii/admin run build",
    "test:backend": "pnpm --filter @cookii/backend run test",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml}\"",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.33.2"
}

