# ==============================================================================
# Cookii Environment: QA / STAGING (Quality Assurance & Integration Testing)
# ==============================================================================
NODE_ENV=qa
PORT=4000
APP_NAME=Cookii-API-QA
API_PREFIX=api/v1
CORS_ORIGIN=https://qa-admin.cookii.in,http://localhost:3000

# Database - QA MongoDB Atlas Cluster (Isolated Sandbox DB)
MONGODB_URI=mongodb+srv://cookii_qa_user:cookii_qa_secret_pass@qa-cluster.mongodb.net/cookii_qa?retryWrites=true&w=majority

# Redis & BullMQ (Upstash Staging Redis)
REDIS_HOST=qa-redis.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=qa_redis_secure_password
REDIS_TLS=true

# Authentication & JWT Secrets (Distinct from Dev and Prod)
JWT_ACCESS_SECRET=cookii_qa_jwt_access_secret_strictly_for_staging_32ch
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=cookii_qa_jwt_refresh_secret_strictly_for_staging_32ch
JWT_REFRESH_EXPIRES_IN=14d

# Phone OTP Provider (msg91 sandbox / firebase test numbers)
OTP_PROVIDER=mock
MOCK_OTP_CODE=998877

# Google OAuth (Staging credentials)
GOOGLE_CLIENT_ID=staging_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=staging_google_client_secret

# Razorpay Test Gateway (Staging keys starting with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_qa_sandbox_key
RAZORPAY_KEY_SECRET=rzp_test_qa_sandbox_secret
RAZORPAY_WEBHOOK_SECRET=rzp_wh_qa_secret

# Maps Provider
MAPS_PROVIDER=maplibre
MAPLIBRE_TILE_URL=https://tiles.openfreemap.org/styles/bright

# Logging & Observability
LOG_LEVEL=info
SENTRY_DSN=https://sentry_qa_key@o000000.ingest.sentry.io/0000000

